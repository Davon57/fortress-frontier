{
  "name": "game",
  "version": "1.0.0",
  "description": "近未来军团塔防网页 Demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"e2e/**/*.ts\" \"*.{json,js,ts,html}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"e2e/**/*.ts\" \"*.{json,js,ts,html}\" \".github/**/*.yml\"",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pixi.js": "^8.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
